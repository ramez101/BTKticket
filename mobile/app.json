{
  "expo": {
    "name": "BTK Easy",
    "slug": "btk-easy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.btkbank.btkeasy",
      "infoPlist": {}
    },
    "android": {
      "package": "com.btkbank.btkeasy",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-status-bar",
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#061A32"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "apiUrl": "http://192.168.10.80:3000",
      "eas": {
        "projectId": "b6f6ec0e-f120-46d5-9bb8-9dc74b24cdcd"
      }
    },
    "owner": "ramirez10"
  }
}
