# XAMPP MySQL/MariaDB (phpMyAdmin) : adapte le mot de passe si root en possède un.
DATABASE_URL="mysql://root:@127.0.0.1:3306/btkticket"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# SMTP de production : remplacez MAIL_HOST par le serveur fourni par votre messagerie.
MAIL_HOST="127.0.0.1"
MAIL_PORT="1025"
MAIL_FROM="BTK Easy <rdv@btk.local>"
# Adresse organisatrice affichée dans les invitations Outlook (.ics).
CALENDAR_ORGANIZER_EMAIL="rdv@btk.local"
EXPO_ACCESS_TOKEN=""
CRON_SECRET=""
# MAIL_SECURE="false"
# MAIL_REQUIRE_TLS="true"
# MAIL_USER=""
# MAIL_PASSWORD=""

# Microsoft Graph / Outlook : application Microsoft Entra ID (web)
# Redirect URI à enregistrer dans Azure : http://localhost:3000/api/outlook/callback
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID="89dfef6d-7fef-4531-bb0e-7de10ddec574"
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/outlook/callback"
# Secret long et aléatoire, utilisé pour chiffrer les refresh tokens stockés en base.
MICROSOFT_TOKEN_ENCRYPTION_KEY=""
